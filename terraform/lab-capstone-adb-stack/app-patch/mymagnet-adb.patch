diff --git a/migrate_sqlite_to_adb.py b/migrate_sqlite_to_adb.py
new file mode 100644
index 0000000..3362f02
--- /dev/null
+++ b/migrate_sqlite_to_adb.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""
+migrate_sqlite_to_adb.py — one-time copy of a MyMagnet SQLite library into
+the Oracle Autonomous AI Database schema (lab-capstone-adb-stack/sql/03).
+
+Run once per SQLite file, from an instance (the ADB is reachable only from
+the private subnet), with the same MAGNET_DB_* env vars the app uses:
+
+    set -a; . /etc/magnetlookup/env; set +a
+    /opt/magnetlookup/venv/bin/python migrate_sqlite_to_adb.py \
+        /opt/magnetlookup/data/magnet_library.db
+
+The two instances each have their OWN SQLite file (no replication until
+now). Run it on instance 1 first, then on instance 2 with --merge:
+
+  * first run (empty target): ids are copied as-is, so search_results
+    still point at the right searches rows.
+  * --merge: torrents/sites/categories/search_terms are merged by their
+    natural keys (seeds take the max, use_count adds up); searches get
+    new ids and their search_results are re-pointed.
+
+Embeddings are NOT computed here; run sql/04_embeddings_and_index.sql
+afterwards (one set-based UPDATE is faster than per-row calls).
+"""
+
+import argparse
+import sqlite3
+import sys
+
+import magnet_db
+
+TORRENT_MERGE = """
+MERGE INTO torrents t
+USING (SELECT ? AS info_hash, ? AS title, ? AS sz, ? AS seeds, ? AS leeches,
+              ? AS first_seen, ? AS last_seen, ? AS magnet FROM dual) s
+ON (t.info_hash = s.info_hash)
+WHEN MATCHED THEN UPDATE SET
+    t.magnet       = CASE WHEN s.seeds >= t.best_seeds THEN s.magnet ELSE t.magnet END,
+    t.best_seeds   = GREATEST(t.best_seeds, s.seeds),
+    t.best_leeches = GREATEST(t.best_leeches, s.leeches),
+    t.first_seen   = LEAST(t.first_seen, s.first_seen),
+    t.last_seen    = GREATEST(t.last_seen, s.last_seen)
+WHEN NOT MATCHED THEN INSERT
+    (info_hash, title, torrent_size, best_seeds, best_leeches,
+     first_seen, last_seen, magnet)
+VALUES (s.info_hash, s.title, s.sz, s.seeds, s.leeches,
+        s.first_seen, s.last_seen, s.magnet)
+"""
+
+SITE_MERGE = """
+MERGE INTO torrent_sites ts
+USING (SELECT ? AS info_hash, ? AS site FROM dual) s
+ON (ts.info_hash = s.info_hash AND ts.site = s.site)
+WHEN NOT MATCHED THEN INSERT (info_hash, site) VALUES (s.info_hash, s.site)
+"""
+
+CATEGORY_MERGE = """
+MERGE INTO categories c USING (SELECT ? AS name FROM dual) s
+ON (c.name = s.name)
+WHEN NOT MATCHED THEN INSERT (name) VALUES (s.name)
+"""
+
+TERM_MERGE = """
+MERGE INTO search_terms st
+USING (SELECT ? AS term, ? AS category, ? AS first_used, ? AS last_used,
+              ? AS use_count FROM dual) s
+ON (st.term = s.term)
+WHEN MATCHED THEN UPDATE SET
+    st.category   = CASE WHEN s.last_used > st.last_used THEN s.category ELSE st.category END,
+    st.first_used = LEAST(st.first_used, s.first_used),
+    st.last_used  = GREATEST(st.last_used, s.last_used),
+    st.use_count  = st.use_count + s.use_count
+WHEN NOT MATCHED THEN INSERT (term, category, first_used, last_used, use_count)
+VALUES (s.term, s.category, s.first_used, s.last_used, s.use_count)
+"""
+
+
+def rows(src, sql):
+    return src.execute(sql).fetchall()
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument('sqlite_file')
+    ap.add_argument('--merge', action='store_true',
+                    help='target already has data: remap searches ids instead of copying them')
+    args = ap.parse_args()
+
+    src = sqlite3.connect(f'file:{args.sqlite_file}?mode=ro', uri=True)
+    src.row_factory = sqlite3.Row
+    dst = magnet_db.connect()
+
+    existing = dst.execute("SELECT COUNT(*) AS n FROM searches").fetchone()['n']
+    if existing and not args.merge:
+        sys.exit(f'Target already has {existing} searches rows; re-run with --merge.')
+
+    # Parents before children (torrent_sites/search_results reference them).
+    # Oracle turns '' into NULL, so empty NOT NULL text gets a placeholder.
+    n = 0
+    for r in rows(src, "SELECT * FROM torrents"):
+        dst.execute(TORRENT_MERGE, (
+            r['info_hash'], r['title'] or '?', r['size'], r['best_seeds'],
+            r['best_leeches'], r['first_seen'], r['last_seen'], r['magnet']))
+        n += 1
+    print(f'torrents:       {n}')
+
+    n = 0
+    for r in rows(src, "SELECT * FROM torrent_sites"):
+        dst.execute(SITE_MERGE, (r['info_hash'], r['site']))
+        n += 1
+    print(f'torrent_sites:  {n}')
+
+    for r in rows(src, "SELECT * FROM categories"):
+        dst.execute(CATEGORY_MERGE, (r['name'],))
+
+    for r in rows(src, "SELECT * FROM search_terms"):
+        dst.execute(TERM_MERGE, (r['term'], r['category'] or 'Default',
+                                 r['first_used'], r['last_used'], r['use_count']))
+
+    # searches: copy ids on the first run; new ids with --merge.
+    id_map = {}
+    for r in rows(src, "SELECT * FROM searches ORDER BY id"):
+        vals = (r['run_at'], r['terms'], r['js_mode'], r['total_found'], r['dupes_removed'])
+        if args.merge:
+            id_map[r['id']] = dst.insert_returning_id(
+                "INSERT INTO searches (run_at, terms, js_mode, total_found, dupes_removed) "
+                "VALUES (?, ?, ?, ?, ?)", vals)
+        else:
+            dst.execute(
+                "INSERT INTO searches (id, run_at, terms, js_mode, total_found, dupes_removed) "
+                "VALUES (?, ?, ?, ?, ?, ?)", (r['id'],) + vals)
+            id_map[r['id']] = r['id']
+    print(f'searches:       {len(id_map)}')
+
+    n = 0
+    for r in rows(src, "SELECT * FROM search_results ORDER BY id"):
+        dst.execute(
+            "INSERT INTO search_results (search_id, info_hash, search_term, seeds) "
+            "VALUES (?, ?, ?, ?)",
+            (id_map[r['search_id']], r['info_hash'], r['search_term'], r['seeds']))
+        n += 1
+    print(f'search_results: {n}')
+
+    dst.commit()
+
+    # The first run inserts explicit searches ids into an identity column;
+    # move the identity past MAX(id) so the app's next INSERT doesn't
+    # collide. (Other tables' ids were generated, so they're already fine.)
+    dst.execute("ALTER TABLE searches MODIFY id "
+                "GENERATED BY DEFAULT ON NULL AS IDENTITY (START WITH LIMIT VALUE)")
+    dst.close()
+    print('Done. Next: sql/04_embeddings_and_index.sql')
+
+
+if __name__ == '__main__':
+    main()
