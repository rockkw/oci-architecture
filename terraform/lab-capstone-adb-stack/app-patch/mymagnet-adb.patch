+def api_similar(conn, q: str, limit: int = 20) -> list[dict]:
+    """
+    Titles semantically similar to q (AI Vector Search). The query text is
+    embedded in the database by the same ONNX model that embedded the
+    titles; ordering by cosine distance lets the HNSW index serve it.
+    """
+    if not q:
+        return []
+    limit = max(1, min(limit, 100))
+    return query(conn, f"""
+        SELECT {T_COLS},
+               VECTOR_DISTANCE(t.title_vec,
+                   VECTOR_EMBEDDING(all_minilm_l12_v2 USING ? AS data),
+                   COSINE) AS distance
+        FROM   torrents t
+        WHERE  t.title_vec IS NOT NULL
+        ORDER  BY VECTOR_DISTANCE(t.title_vec,
+                   VECTOR_EMBEDDING(all_minilm_l12_v2 USING ? AS data),
+                   COSINE)
+        FETCH APPROX FIRST ? ROWS ONLY
+    """, (q, q, limit))
+
