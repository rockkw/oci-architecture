+"""
+magnet_db.py — Oracle Autonomous AI Database connection for MyMagnet.
+
+Replaces the per-node SQLite file with one shared database, reached over
+the ADB private endpoint with python-oracledb in Thin mode (pure Python,
+no Oracle Client libraries, no wallet: the database has mTLS turned off,
+so TLS with a user/password is enough).
+
+Settings come from the environment (/etc/magnetlookup/env):
+  MAGNET_DB_USER      default "magnet"
+  MAGNET_DB_PASSWORD  the mymagnet-adb-app-password Vault secret
+  MAGNET_DB_DSN       the ADB's TLS connect string for the _tp service
+                      (Terraform output connection_profiles), port 1522
+
+The wrapper keeps the sqlite3 call shape the app already uses —
+conn.execute(sql, params) with "?" placeholders, rows readable as dicts,
+conn.commit()/close() — so the call sites barely change. SQL text itself
+still had to move to Oracle syntax (MERGE, FETCH FIRST, LISTAGG).
+"""
+
+import os
+import re
+
+import oracledb
+
+_pool = None
+
+
+def _get_pool():
+    # One small pool per process. webserver.py opens a connection per HTTP
+    # request; a TLS handshake to ADB per request would add noticeable
+    # latency, so connections are reused. close() returns them to the pool.
+    global _pool
+    if _pool is None:
+        _pool = oracledb.create_pool(
+            user=os.environ.get('MAGNET_DB_USER', 'magnet'),
+            password=os.environ['MAGNET_DB_PASSWORD'],
+            dsn=os.environ['MAGNET_DB_DSN'],
+            min=1, max=4, increment=1,
+        )
+    return _pool
+
+
+_QMARK = re.compile(r"\?")
+
+
+def _to_oracle_binds(sql: str) -> str:
+    """Rewrite sqlite "?" placeholders as Oracle positional :1, :2, ...
+
+    Naive on purpose: none of the app's SQL has a literal "?" inside a
+    string constant. Values that contain "?" are bind values, not SQL, so
+    they are unaffected.
+    """
+    n = 0
+
+    def repl(_m):
+        nonlocal n
+        n += 1
+        return f':{n}'
+    return _QMARK.sub(repl, sql)
+
+
+def _dict_rows(cursor):
+    # Oracle reports unquoted column names in upper case; the app and its
+    # JSON API expect the lower-case names sqlite3.Row gave.
+    cols = [d[0].lower() for d in cursor.description]
+    cursor.rowfactory = lambda *vals: dict(zip(cols, vals))
+
+
+class Connection:
+    def __init__(self, raw):
+        self._raw = raw
+
+    def execute(self, sql: str, params=()):
+        cur = self._raw.cursor()
+        cur.execute(_to_oracle_binds(sql), list(params))
+        if cur.description:
+            _dict_rows(cur)
+        return cur
+
+    def insert_returning_id(self, sql: str, params=()) -> int:
+        """INSERT ... and return the new identity value (sqlite's
+        cursor.lastrowid). `sql` must not include the RETURNING clause."""
+        cur = self._raw.cursor()
+        new_id = cur.var(int)
+        cur.execute(_to_oracle_binds(sql + ' RETURNING id INTO ?'),
+                    list(params) + [new_id])
+        return int(new_id.getvalue()[0])
+
+    def commit(self):
+        self._raw.commit()
+
+    def rollback(self):
+        self._raw.rollback()
+
+    def close(self):
+        # Returns the connection to the pool. Uncommitted work is rolled
+        # back, same as closing a sqlite3 connection.
+        self._raw.close()
+
+
+def connect() -> Connection:
+    return Connection(_get_pool().acquire())
